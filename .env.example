# Misan runtime configuration. Copy to .env and adjust as needed.

# SQLite database path (operational store: diagnostic records, model/dataset registry)
MISAN_DB_PATH=data/misan.db

# Directory for imported/simulated datasets
MISAN_DATA_DIR=data

# Directory where trained model artifacts are written/read
MISAN_MODELS_DIR=data/models

# Base URL the Streamlit dashboard uses to reach the FastAPI service
MISAN_API_BASE_URL=http://127.0.0.1:8000

# Detection persistence rule: consecutive abnormal windows required before alerting
MISAN_PERSISTENCE_N=3

# Confidence below which a diagnosis is reported as low-confidence/unknown (FR-14)
MISAN_CONFIDENCE_THRESHOLD=0.45
